# Application Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=DairyMarketplacePlatform

# Database Configuration (PostgreSQL via Prisma)
DATABASE_URL=postgresql://dairy_user:dairy_password@localhost:5433/dairy_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (JWT)
JWT_SECRET=super-secret-dairy-jwt-access-key-production-change-this
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-dairy-jwt-refresh-key-production-change-this
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=10

# External Service Stubs / Providers (Configurable abstractions)
PAYMENT_PROVIDER=MOCK
PAYMENT_API_KEY=test_payment_api_key
PAYMENT_WEBHOOK_SECRET=test_webhook_secret_key

STORAGE_PROVIDER=LOCAL
STORAGE_BASE_URL=http://localhost:4000/uploads
CDN_BASE_URL=https://cdn.example.com

# Admin Portal Integration
ADMIN_PORT=4001
MAIN_BACKEND_URL=http://localhost:4000
