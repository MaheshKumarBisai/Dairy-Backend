# ==============================================================================
# Application Configuration
# ==============================================================================
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
APP_NAME=DairyMarketplacePlatform

# ==============================================================================
# Database Configuration (Amazon RDS PostgreSQL in Private Subnet)
# Replace 'YourSecurePassword123!' with your actual master RDS password
# ==============================================================================
DATABASE_URL=postgresql://postgres:YourSecurePassword123!@dairy-backend.cfoqq6cwepty.us-east-2.rds.amazonaws.com:5432/postgres?schema=public

# ==============================================================================
# Redis Configuration (Local Container or Amazon ElastiCache)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
JWT_SECRET=super-secret-dairy-jwt-access-key-production-change-this
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-dairy-jwt-refresh-key-production-change-this
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=10

# ==============================================================================
# External Service Stubs / Providers
# ==============================================================================
PAYMENT_PROVIDER=MOCK
PAYMENT_API_KEY=test_payment_api_key
PAYMENT_WEBHOOK_SECRET=test_webhook_secret_key

# ==============================================================================
# Amazon S3 & Cloud Media Storage
# ==============================================================================
AWS_REGION=us-east-2
AWS_S3_BUCKET_NAME=prod-dairy-images-09876
STORAGE_PROVIDER=S3
STORAGE_BASE_URL=https://prod-dairy-images-09876.s3.us-east-2.amazonaws.com

# ==============================================================================
# Admin Portal & ALB Routing
# ==============================================================================
ADMIN_PORT=4001
MAIN_BACKEND_URL=http://dairy-lb-2052637137.us-east-2.elb.amazonaws.com
